#!/bin/bash
# caps-indicator — Claude Code status states on the Caps Lock LED.
#
#   caps-indicator working   slow blink (Claude is thinking / running tools)
#   caps-indicator waiting   fast blink (it needs you: permission prompt, question)
#   caps-indicator done      solid on (task finished)
#   caps-indicator off       dark (session closed)
#   caps-indicator reset     kill everything and turn the LED off
#
#   caps-indicator disable   mute the indicator (hooks stay wired, they just do nothing)
#   caps-indicator enable    unmute it
#   caps-indicator status    report muted/active and the current state
#
# Called from Claude Code hooks. Concurrent sessions are handled: each session's state
# is tracked separately and the highest-priority one wins the LED
# (waiting > working > done > off).
#
# Set CAPSLIGHT_DISABLED=1 in the environment to mute a single session without
# touching the global switch.

set -u

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CAPSLED="$SELF_DIR/capsled"

STATE_DIR="${CAPS_INDICATOR_HOME:-$HOME/.claude/capsled}"
SESS_DIR="$STATE_DIR/sessions"
PIDFILE="$STATE_DIR/blink.pid"
CURFILE="$STATE_DIR/current"
LOCKDIR="$STATE_DIR/lock"
MUTEFILE="$STATE_DIR/disabled"

# Blink shape: cycle length and the fraction of it the LED stays lit.
WORKING_INTERVAL="${CAPS_WORKING_INTERVAL:-0.7}"
WORKING_DUTY="${CAPS_WORKING_DUTY:-0.35}"
WAITING_INTERVAL="${CAPS_WAITING_INTERVAL:-0.22}"
WAITING_DUTY="${CAPS_WAITING_DUTY:-0.5}"

mkdir -p "$SESS_DIR"

[ -x "$CAPSLED" ] || { echo "caps-indicator: $CAPSLED not found" >&2; exit 1; }

# --- helpers -----------------------------------------------------------------

priority() {
  case "$1" in
    waiting) echo 3 ;;
    working) echo 2 ;;
    done)    echo 1 ;;
    *)       echo 0 ;;
  esac
}

# Crude lock so concurrent hooks don't fight over the LED.
acquire_lock() {
  local tries=0
  while ! mkdir "$LOCKDIR" 2>/dev/null; do
    # clear a stale lock (older than ~10 seconds)
    if [ -n "$(find "$LOCKDIR" -maxdepth 0 -mmin +0.17 2>/dev/null)" ]; then
      rmdir "$LOCKDIR" 2>/dev/null
    fi
    tries=$((tries + 1))
    [ "$tries" -gt 50 ] && return 0
    sleep 0.02
  done
  trap 'rmdir "$LOCKDIR" 2>/dev/null' EXIT
}

stop_blinker() {
  if [ -f "$PIDFILE" ]; then
    local pid
    pid="$(cat "$PIDFILE" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null
      # give it a moment to turn the LED off on its way out
      local i=0
      while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
        sleep 0.02
        i=$((i + 1))
      done
      kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
    fi
    rm -f "$PIDFILE"
  fi
}

start_blinker() {
  local interval="$1" duty="$2"
  nohup "$CAPSLED" blink "$interval" "$duty" >/dev/null 2>&1 &
  echo $! > "$PIDFILE"
  disown 2>/dev/null || true
}

apply() {
  local state="$1"
  # already in this state — do nothing, so the blink doesn't restart on every PostToolUse
  [ -f "$CURFILE" ] && [ "$(cat "$CURFILE" 2>/dev/null)" = "$state" ] && return 0

  stop_blinker
  case "$state" in
    working) start_blinker "$WORKING_INTERVAL" "$WORKING_DUTY" ;;
    waiting) start_blinker "$WAITING_INTERVAL" "$WAITING_DUTY" ;;
    done)    "$CAPSLED" on  >/dev/null 2>&1 ;;
    *)       "$CAPSLED" off >/dev/null 2>&1 ;;
  esac
  echo "$state" > "$CURFILE"
}

# --- main --------------------------------------------------------------------

want="${1:-}"
[ -n "$want" ] || {
  echo "usage: caps-indicator working|waiting|done|off|reset|disable|enable|status" >&2
  exit 1
}

# The mute switch, handled before anything else so it stays cheap and always works.
case "$want" in
  disable)
    acquire_lock
    : > "$MUTEFILE"
    stop_blinker
    rm -f "$CURFILE"
    "$CAPSLED" off >/dev/null 2>&1
    echo "capslight: muted — hooks stay wired but the LED stays dark"
    echo "           re-enable with: caps-indicator enable"
    exit 0
    ;;
  enable)
    rm -f "$MUTEFILE"
    echo "capslight: active again — the next hook will light it up"
    exit 0
    ;;
  status)
    if [ -f "$MUTEFILE" ]; then
      echo "muted (caps-indicator enable to turn it back on)"
    else
      echo "active, current state: $(cat "$CURFILE" 2>/dev/null || echo off)"
    fi
    exit 0
    ;;
esac

# Muted? Drain stdin so the caller never sees a broken pipe, then do nothing.
# `reset` deliberately still works, as the way out of a stuck LED.
if [ "$want" != "reset" ] && { [ -f "$MUTEFILE" ] || [ -n "${CAPSLIGHT_DISABLED:-}" ]; }; then
  [ -t 0 ] || cat >/dev/null 2>&1
  exit 0
fi

# --- identify the session ----------------------------------------------------

session_id=""
if [ ! -t 0 ]; then
  payload="$(cat 2>/dev/null)"
  session_id="$(printf '%s' "$payload" \
    | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    | head -1)"
fi
[ -n "$session_id" ] || session_id="pid-$PPID"
# normalise, in case the id carries anything odd
session_id="$(printf '%s' "$session_id" | tr -c 'A-Za-z0-9._-' '_')"

acquire_lock

if [ "$want" = "reset" ]; then
  rm -f "$SESS_DIR"/* 2>/dev/null
  rm -f "$CURFILE"
  stop_blinker
  "$CAPSLED" off >/dev/null 2>&1
  exit 0
fi

if [ "$want" = "off" ]; then
  rm -f "$SESS_DIR/$session_id"
else
  echo "$want" > "$SESS_DIR/$session_id"
fi

# drop sessions silent for over 4 hours (Claude killed / crashed)
find "$SESS_DIR" -maxdepth 1 -type f -mmin +240 -delete 2>/dev/null

# effective state = highest priority across all live sessions
effective="off"
best=0
for f in "$SESS_DIR"/*; do
  [ -f "$f" ] || continue
  s="$(cat "$f" 2>/dev/null)"
  p="$(priority "$s")"
  if [ "$p" -gt "$best" ]; then
    best="$p"
    effective="$s"
  fi
done

apply "$effective"
exit 0
